
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Detailed user profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Workout": {
      "title": "Workout Session",
      "description": "A recorded workout session for a user",
      "type": "object",
      "properties": {
        "exercise": { "type": "string" },
        "reps": { "type": "number" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["exercise", "reps", "timestamp", "userId"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "#/entities/Workout",
      "description": "Individual workout logs"
    }
  }
}
